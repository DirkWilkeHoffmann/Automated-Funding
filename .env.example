# Backend Configuration
# =====================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- Supabase (REQUIRED) ---
# Get from: https://supabase.com/dashboard/project/uacnlbnskuqwtvebjfgp/settings/api
SUPABASE_URL=https://uacnlbnskuqwtvebjfgp.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>        # "service_role" secret — NOT the anon key

# --- OpenAI (optional — can also be set via Admin panel in the UI) ---
OPENAI_API_KEY=sk-...

# --- Logging ---
LOG_LEVEL=INFO
